{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "schedule": ["* 0-3 */3 * *"],
  "timezone": "America/Argentina/Buenos_Aires",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": { "enabled": true, "schedule": ["* 0-3 */3 * *"] },
  "packageRules": [
    {
      "description": "Plain typescript only feeds typescript-eslint, which doesn't support TS 7 yet. Typecheck uses @typescript/native.",
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}

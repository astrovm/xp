{
  "packageManager": "bun@1.4.4",
  "scripts": {
    "test": "bun run typecheck && bun test --parallel=4 --timeout 30000 && bun run validate:javascript && bun run validate:icons",
    "test:coverage": "COVERAGE=1 bun test --parallel=4 --timeout 30000 && bun tools/coverage-report.ts --skip-full",
    "build": "bun tools/deploy.ts",
    "build:pinball-runtime": "bun tools/build-pinball-runtime.ts",
    "dev": "bun tools/dev-server.ts",
    "preview": "bun tools/dev-server.ts --production",
    "deploy": "wrangler deploy --config worker/wrangler.toml && wrangler deploy --config worker/wrangler.legacy.toml",
    "extract:xp-assets": "bun tools/extract-xp-assets.ts",
    "extract:pinball-assets": "bun tools/extract-pinball-assets.ts",
    "compare:xp-ui": "bun tools/compare-xp-ui.ts",
    "extract:swf": "bun tools/extract-swf.ts",
    "find:icons": "bun tools/find-flashpoint-icons.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "bun run --parallel format:check lint",
    "sync:icons": "bun tools/sync-game-icons.ts",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "validate:icons": "bun tools/validate-icons.ts --require-all",
    "validate:javascript": "bun tools/validate-javascript.ts",
    "verify:xp-assets": "bun tools/extract-xp-assets.ts --check",
    "verify:pinball-assets": "bun tools/extract-pinball-assets.ts --check",
    "xp:vm": "bun tools/xp-vm.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "^1.4.2",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "wawoff2": "2.0.1",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@nktkas/bmp": "^5.0.0",
    "@ruffle-rs/ruffle": "^0.7.0",
    "fflate": "^0.8.3",
    "js-dos": "^8.5.3",
    "sharp": "^0.35.5",
    "webtorrent": "^3.0.21"
  }
}

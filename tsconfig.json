{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": [
    "catalog/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "worker/**/*.ts",
    "precache-config.ts"
  ]
}
